# Configuración optimizada para Hostinger (LiteSpeed / Apache)
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar conexión segura HTTPS en el dominio de Hostinger
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # URL corta para la página de registro y citas de clientas
  RewriteRule ^(clientes|registro|citas|reservar)$ clientes.html [L]

  # Panel del equipo (la raíz es la página pública del estudio)
  RewriteRule ^(panel|equipo)$ panel.html [L]
</IfModule>

# Manifiestos de la app instalable (notificaciones en iPhone requieren instalarla)
AddType application/manifest+json .webmanifest

# Caché pensada para móviles:
# - HTML: siempre se revalida (así los cambios se ven al instante).
# - CSS/JS: llevan ?v=... en las páginas, se guardan 1 año sin volver a descargarse.
# - config.js y sw.js: siempre se revalidan (configuración y service worker).
# - Íconos e imágenes: 30 días.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(config|sw)\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|webp|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Proteger archivos sensibles de configuración y base de datos
<FilesMatch "^(config\.php|database\.sql|niskin_state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Compresión GZIP para carga ultrarrápida en móviles
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
