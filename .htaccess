# Configuración optimizada para Hostinger (LiteSpeed / Apache)
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar conexión segura HTTPS en el dominio de Hostinger
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Proteger archivos sensibles de configuración y base de datos
<FilesMatch "^(config\.php|database\.sql|niskin_state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Compresión GZIP para carga ultrarrápida en móviles
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
