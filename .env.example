# Cadena de conexión de MongoDB Atlas (reemplaza usuario, contraseña y nombre del cluster)
MONGODB_URI=mongodb+srv://usuario_niskin:TU_PASSWORD@cluster0.xxxxx.mongodb.net/niskin_beauty_studio?retryWrites=true&w=majority

# Contraseña para entrar al panel administrativo (usa una larga y única)
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar las sesiones (cadena aleatoria larga; Render la genera sola con render.yaml)
AUTH_SECRET=genera-una-cadena-aleatoria-larga

# Opcional: dominios que pueden usar la API, separados por coma
# ALLOWED_ORIGINS=https://dodgerblue-gaur-604591.hostingersite.com

# Puerto del servidor en Render (Render usa 10000 por defecto)
PORT=10000
NODE_ENV=production
